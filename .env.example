# 배포 도메인 (프로토콜 포함, 끝에 슬래시 없이)
#
# metadataBase / Open Graph / canonical / sitemap.xml / robots.txt 의 절대 URL 을
# 만드는 데 쓰인다.
#
# 설정하지 않으면 http://localhost:3000 으로 폴백한다.
#   - 로컬 개발에서는 그대로 두면 된다.
#   - 배포 시 설정하지 않으면 공유 링크 미리보기와 sitemap 이 전부 localhost 를
#     가리키므로 반드시 설정할 것.
#
# 예) https://sospatial.kr
NEXT_PUBLIC_SITE_URL=
